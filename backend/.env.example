# Copy to .env and fill in. Never commit .env.
# On Vercel, set the same names in the API project's Environment Variables.

# ── Local server only (ignored on Vercel) ──
FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000

# ── Required: the API answers 503 NOT_CONFIGURED until these four are set ──
DB_HOST=localhost
DB_NAME=rede_now
DB_USER=
# Long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# ── Database ──
DB_PORT=3306
DB_PASSWORD=
# true for any hosted MySQL (TiDB Cloud, PlanetScale...). TLS is verified
# against certifi's CA bundle unless DB_SSL_CA points at another one.
DB_SSL=false
DB_SSL_CA=

# ── Browser origins allowed to call the API (comma-separated, no wildcard) ──
FRONTEND_ORIGIN=http://localhost:8080
# Optional: one explicit regex for preview deployments, e.g.
# https://red-e-now-[a-z0-9-]+-yourteam\.vercel\.app
FRONTEND_ORIGIN_REGEX=

# ── Behaviour ──
# Login lifetime in hours
JWT_EXPIRES_HOURS=12
# The building's clock. Pickup slots and handoff times are stored in this zone.
APP_TIMEZONE=America/New_York
# true opens Saturday and Sunday for pickups (default: Monday to Friday)
PICKUP_WEEKENDS=false
# Per-IP limits (Flask-Limiter syntax)
RATE_LIMIT_LOGIN=20 per minute;200 per hour
RATE_LIMIT_REGISTER=5 per minute;30 per hour
